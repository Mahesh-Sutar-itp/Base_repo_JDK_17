<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.12</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>

  <groupId>org.trebolecommerce</groupId>
  <artifactId>trebol-platform</artifactId>
  <packaging>pom</packaging>
  <version>0.3.0-SNAPSHOT</version>

  <name>Trébol Platform</name>
  <description>
    Aggregator for the Trébol eCommerce platform, now decomposed into three independently deployable
    services.

    Phase 4 removed the trebol-backend-monolith module. Every one of the 67 routes it served is now
    served by exactly one of the three services below, which own their schemas exclusively. The
    monolith remains in git history - it was deleted, not rewritten - so nothing is lost, but it is
    no longer built, tested or deployable.

    Reactor order is significant: shared-contracts publishes the generated authority catalogue that
    every service consumes, so it builds first. It also now hosts the generator and the integrity
    test that keep that catalogue a generated artefact rather than a hand-maintained one (X6); both
    moved out of the monolith's test tree during decommissioning.
  </description>

  <modules>
    <!-- Published cross-service contracts, including the generated authority catalogue. -->
    <module>trebol-services/shared-contracts</module>

    <!-- Phase 1: Catalogue - products, categories, lists, images, and the company-profile read. -->
    <module>trebol-services/catalogue-service</module>

    <!--
      Phase 2: Identity - people, accounts, roles, authority grants, customers and salespeople.
      The only service that issues tokens; every other service verifies locally (ADR-002).
    -->
    <module>trebol-services/identity-service</module>

    <!--
      Phase 3: Orders - the transactional core. Orders, lines, the status lifecycle, checkout, the
      Webpay Plus adapter, the notification outbox and the public receipt, carrying the billing and
      shipper domains with it. Extracted last, because it is the only service with cross-service
      couplings to cut: the catalogue product reference, the receipt's entity dereference, and the
      "customer" sort key that reached into Identity.
    -->
    <module>trebol-services/orders-service</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>21</java.version>
  </properties>

</project>
