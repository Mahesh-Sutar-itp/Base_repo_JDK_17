<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.trebolecommerce</groupId>
    <artifactId>trebol-platform</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>trebol-shared-contracts</artifactId>
  <packaging>jar</packaging>

  <name>Trébol Shared Contracts</name>
  <description>
    Contracts published across service boundaries, consumed by the monolith and by every extracted
    service. Deliberately dependency-free: no Spring starters, no persistence, no web layer, and no
    Spring Boot repackaging - it is a plain library jar so that adding it to a module cannot change
    that module's runtime behaviour.

    It currently holds the generated authority catalogue (org.trebol.security.authorities.AuthorityCodes),
    whose 54 codes are a client-observable contract embedded in every issued token. The catalogue is
    generated from business-rules-extraction/database-documentation/00-seed-data.json and verified
    against it on every build by AuthorityCatalogueIntegrityTest, which lives with the seed data in
    the monolith module and fails the build on any drift or unknown code.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>21</java.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
