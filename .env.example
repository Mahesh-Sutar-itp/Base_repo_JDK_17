# Values for compose.yaml. Copy this file to .env (never committed) and choose your own local values.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
# JWT signing key: at least 32 bytes, otherwise the API refuses to start
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-bytes

# Optional: one-at-a-time Maven downloads, for networks where parallel downloads stall
# MAVEN_EXTRA_ARGS=-Daether.dependencyCollector.bf.threads=1 -Daether.connector.basic.threads=1
